# Last.fm API Configuration for Spotify Now Playing
PUBLIC_LASTFM_API_KEY=
PUBLIC_LASTFM_USERNAME=

# Newsletter API endpoint
PUBLIC_NEWSLETTER_ENDPOINT=/api/subscribe

# Newsletter backend
DATABASE_URL=
RESEND_API_KEY=
NEWSLETTER_FROM_EMAIL=
NEWSLETTER_NOTIFY_SECRET=
