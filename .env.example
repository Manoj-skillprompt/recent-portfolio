# Environment variables declared in this file are automatically made available to your frontend.
# Feel free to add, modify, or remove functions in this file to customize the application.

# General Site Configuration
NEXT_PUBLIC_SITE_URL=https://yourwebsite.com
NEXT_PUBLIC_SITE_TITLE="Your Awesome Portfolio"
NEXT_PUBLIC_SITE_DESCRIPTION="A professional portfolio template for developers."

# GitHub Integration (used in components for displaying repos, etc.)
# Replace 'your-github-username' with the actual GitHub username
NEXT_PUBLIC_GITHUB_USERNAME=your-github-username

# Email Configuration (for contact forms or direct mailto links)
# Replace with the desired email address
NEXT_PUBLIC_EMAIL=jane.doe@example.com

# Social Links (can be used for header/footer links, if not handled by config directly)
# NEXT_PUBLIC_LINKEDIN_USERNAME=your-linkedin-username
# NEXT_PUBLIC_TWITTER_USERNAME=your-twitter-username

# Analytics
# For Google Analytics (gtag.js)
# NEXT_PUBLIC_GOOGLE_ANALYTICS=G-XXXXXXXXXX
# For Umami Analytics
# NEXT_PUBLIC_UMAMI_ID=your-umami-id
# NEXT_PUBLIC_UMAMI_URL=https://analytics.yourdomain.com

# Other potential variables
# NEXT_PUBLIC_RESUME_URL=/files/resume.pdf # Link to resume file in public directory

# Example for API keys if needed (e.g., for a contact form service)
# API_KEY_CONTACT_FORM=your_api_key
