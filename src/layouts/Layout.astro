---
import '../styles/global.css';

export interface Props {
	title: string;
	description?: string;
	resetScrollOnLoad?: boolean;
}

const { title, description, resetScrollOnLoad = false } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" data-reset-scroll={resetScrollOnLoad ? 'true' : undefined}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		<script>
			{`(function() {
				document.documentElement.classList.add('dark');
			})();`}
		</script>
		<script>
			(() => {
				if (document.documentElement.dataset.resetScroll !== 'true') return;

				const navigation = performance.getEntriesByType('navigation')[0];
				const navigationType = navigation?.type ?? 'navigate';
				const shouldStartAtTop = !window.location.hash && (navigationType === 'navigate' || navigationType === 'reload');

				if (shouldStartAtTop) {
					history.scrollRestoration = 'manual';
					const resetScroll = () => window.scrollTo({ top: 0, left: 0, behavior: 'auto' });

					resetScroll();
					window.addEventListener('pageshow', (event) => {
						if (!event.persisted) resetScroll();
					});
					window.addEventListener('load', resetScroll, { once: true });
					window.addEventListener('pagehide', () => {
						history.scrollRestoration = 'auto';
					});
				}
			})();
		</script>
	</head>
	<body class="bg-background text-foreground selection:bg-accent-soft">
		<div class="max-w-267 mx-auto flex flex-col min-h-screen">
			<slot />
		</div>
	</body>
</html>
