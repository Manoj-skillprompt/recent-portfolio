---
import '../styles/global.css';
import { SITE_URL, SITE_TITLE } from '../config/site';
import { PROFILE_INFO, SOCIALS } from '../config/profile';
import SEO_CONFIG from '../config/seo';

export interface Props {
	title: string;
	description?: string;
	resetScrollOnLoad?: boolean;
	ogType?: 'website' | 'article';
	article?: {
		publishedTime: string;
		modifiedTime?: string;
	};
}

const { title, description, resetScrollOnLoad = false, ogType = 'website', article } = Astro.props;
const pageTitle = title || SEO_CONFIG.defaultTitle;
const pageDescription = description || SEO_CONFIG.defaultDescription;
const pageUrl = new URL(Astro.url.pathname, SITE_URL).toString();
const sameAs = [...new Set(SOCIALS.filter((social) => social.url).map((social) => social.url))];
const personSchema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: PROFILE_INFO.name,
	jobTitle: PROFILE_INFO.role,
	description: pageDescription,
	url: SITE_URL,
	image: `${SITE_URL}/profile.png`,
	email: `mailto:${PROFILE_INFO.email}`,
	address: {
		'@type': 'PostalAddress',
		addressLocality: PROFILE_INFO.location,
	},
	knowsAbout: [
		'JavaScript',
		'Typescript',
		'React',
		'Astro',
		'Frontend Development',
		'Full Stack Development',
		'Web Development',
		'Software Development'
	],
	sameAs,
};

const websiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: SITE_TITLE,
	url: SITE_URL,
	description: pageDescription,
	inLanguage: 'en',
	potentialAction: {
		'@type': 'SearchAction',
		target: `${SITE_URL}/?q={search_term_string}`,
		'query-input': 'required name=search_term_string',
	},
};

const articleSchema = article
	? {
			'@context': 'https://schema.org',
			'@type': 'BlogPosting',
			headline: title,
			description: pageDescription,
			image: `${SITE_URL}/profile.png`,
			author: {
				'@type': 'Person',
				name: PROFILE_INFO.name,
				url: `${SITE_URL}/#about`,
			},
			publisher: {
				'@type': 'Person',
				name: PROFILE_INFO.name,
			},
			mainEntityOfPage: pageUrl,
			datePublished: article.publishedTime,
			...(article.modifiedTime ? { dateModified: article.modifiedTime } : {}),
		}
	: null;

const structuredData = [websiteSchema, personSchema, ...(articleSchema ? [articleSchema] : [])];
---

<!DOCTYPE html>
<html lang="en" data-reset-scroll={resetScrollOnLoad ? 'true' : undefined}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={pageDescription} />
		<meta name="author" content={PROFILE_INFO.name} />
		<meta name="robots" content="index, follow" />
		<meta name="theme-color" content="#0f172a" />
		<title>{pageTitle}</title>
		<link rel="canonical" href={pageUrl} />
		<link rel="alternate" type="application/rss+xml" title={`${SITE_TITLE} | RSS Feed`} href={`${SITE_URL}/feed.xml`} />
		{ogType === 'article' && (
			<meta property="article:published_time" content={article?.publishedTime} />
			<meta property="article:modified_time" content={article?.modifiedTime || article?.publishedTime} />
			<meta property="article:author" content={`${SITE_URL}/#about`} />
		)}
		<meta property="og:locale" content="en_US" />
		<meta property="og:site_name" content={SITE_TITLE} />
		<meta property="og:type" content={ogType} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:image" content={SEO_CONFIG.openGraph['og:image']} />
		<meta property="og:image:alt" content={pageTitle} />
		<meta name="twitter:card" content={SEO_CONFIG.twitter['twitter:card']} />
		<meta name="twitter:site" content={SEO_CONFIG.twitter['twitter:site']} />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={pageDescription} />
		<meta name="twitter:url" content={pageUrl} />
		<meta name="twitter:image" content={SEO_CONFIG.twitter['twitter:image']} />
		<meta name="twitter:image:alt" content={pageTitle} />
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
		<script>
			{`(function() {
				document.documentElement.classList.add('dark');
			})();`}
		</script>
		<script>
			(() => {
				if (document.documentElement.dataset.resetScroll !== 'true') return;

				const navigation = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
				const navigationType = navigation?.type ?? 'navigate';
				const shouldStartAtTop = !window.location.hash && (navigationType === 'navigate' || navigationType === 'reload');

				if (shouldStartAtTop) {
					history.scrollRestoration = 'manual';
					const resetScroll = () => window.scrollTo({ top: 0, left: 0, behavior: 'auto' });

					resetScroll();
					window.addEventListener('pageshow', (event) => {
						if (!event.persisted) resetScroll();
					});
					window.addEventListener('load', resetScroll, { once: true });
					window.addEventListener('pagehide', () => {
						history.scrollRestoration = 'auto';
					});
				}
			})();
		</script>
	</head>
	<body class="bg-background text-foreground selection:bg-accent-soft">
		<div class="mx-auto flex min-h-screen w-full max-w-267 flex-col px-4">
			<slot />
		</div>
	</body>
</html>
