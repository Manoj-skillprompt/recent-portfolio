---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import Header from '../components/Header';
import Hero from '../components/Hero';
import Experience from '../components/Experience';
import Projects from '../components/Projects';
import Footer from '../components/Footer';
import { ChevronRight } from 'lucide-react';
import { SITE_TITLE, SITE_DESCRIPTION } from '../config/site';
import type { GitHubUser, GitHubRepo, GitHubStats } from '../config/interfaces/github';

const blogPosts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const GITHUB_USERNAME = import.meta.env.PUBLIC_GITHUB_USERNAME || '';

let gitHubData: GitHubStats | null = null;

if (GITHUB_USERNAME && GITHUB_USERNAME !== 'your-github-username') {
  try {
    const [userResult, reposResult, contributionsResult] = await Promise.allSettled([
      fetch(`https://api.github.com/users/${GITHUB_USERNAME}`, { signal: AbortSignal.timeout(10000) }),
      fetch(`https://api.github.com/users/${GITHUB_USERNAME}/repos?per_page=100&sort=updated`, {
        signal: AbortSignal.timeout(10000),
      }),
      fetch(`https://github-contributions-api.jogruber.de/v4/${GITHUB_USERNAME}`, {
        signal: AbortSignal.timeout(10000),
      }),
    ]);

    const userRes = userResult.status === 'fulfilled' && userResult.value.ok ? userResult.value : null;
    const reposRes = reposResult.status === 'fulfilled' && reposResult.value.ok ? reposResult.value : null;
    const contributionsRes =
      contributionsResult.status === 'fulfilled' && contributionsResult.value.ok ? contributionsResult.value : null;

    if (userRes && reposRes) {
      const user: GitHubUser = await userRes.json();
      const repos: GitHubRepo[] = await reposRes.json();
      const contributionResponse: { contributions: GitHubStats['contributions'] } = contributionsRes
        ? await contributionsRes.json()
        : { contributions: [] };

      const totalStars = repos.reduce((sum, repo) => sum + repo.stargazers_count, 0);
      const totalForks = repos.reduce((sum, repo) => sum + repo.forks_count, 0);

      const topRepos = repos
        .filter((r) => !r.fork)
        .sort((a, b) => b.stargazers_count - a.stargazers_count)
        .slice(0, 6);

      gitHubData = { user, repos: topRepos, totalStars, totalForks, contributions: contributionResponse.contributions };
    } else {
      console.warn('GitHub profile data is unavailable during the build.');
    }
  } catch (err) {
    console.warn('GitHub data could not be loaded during the build:', err instanceof Error ? err.message : err);
  }
}
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <Header client:load />
  <main class='grow'>
    <Hero client:load data={gitHubData} />
    <Experience client:visible />
    <Projects />
    <section id='blog' class='mb-12'>
      <div class='mb-8 flex items-end justify-between gap-4'>
        <div>
          <h3 class='text-xl font-bold text-foreground'>From the blog</h3>
          <p class='mt-2 text-base text-muted'>Here are some of the recent articles from my blog.</p>
        </div>
      </div>
      <ul class='grid gap-5 sm:grid-cols-2'>
        {
          blogPosts.slice(0, 4).map((post) => (
            <li class='h-full'>
              <a href={`/blog/${post.id}/`} class='home-blog-card group'>
                <div class='home-blog-card__content'>
                  <h4 class='mb-3 text-xl font-bold text-foreground transition-colors duration-300 group-hover:text-(--color-primary)'>
                    {post.data.title}
                  </h4>
                  <p class='text-base leading-relaxed text-muted'>{post.data.description}</p>
                  <p class='mt-7 text-sm text-muted'>
                    <time datetime={post.data.pubDate.toISOString()}>
                      {post.data.pubDate.toLocaleDateString('en-us', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric',
                      })}
                    </time>
                  </p>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
      {
        blogPosts.length > 4 && (
          <div class='flex justify-center'>
            <a
              href='/blog/'
              class='mt-7 inline-flex items-center text-sm font-medium text-(--color-primary) transition-colors duration-300 hover:text-green-600'
            >
              View all blogs
              <ChevronRight className='ml-1 h-4 w-4' aria-hidden='true' />
            </a>
          </div>
        )
      }
    </section>
  </main>
  <Footer />
</Layout>

<script>
  const blogCards = document.querySelectorAll<HTMLElement>('.home-blog-card');

  blogCards.forEach((card) => {
    card.addEventListener('pointermove', (event) => {
      const bounds = card.getBoundingClientRect();
      const x = ((event.clientX - bounds.left) / bounds.width) * 100;
      const y = ((event.clientY - bounds.top) / bounds.height) * 100;

      card.style.setProperty('--pointer-x', `${x}%`);
      card.style.setProperty('--pointer-y', `${y}%`);
      card.style.setProperty('--pointer-glow', 'color-mix(in srgb, var(--color-primary) 18%, transparent)');
    });

    card.addEventListener('pointerleave', () => {
      card.style.setProperty('--pointer-glow', 'transparent');
    });
  });
</script>

<style>
  .home-blog-card {
    --pointer-x: 50%;
    --pointer-y: 50%;
    --pointer-glow: transparent;
    position: relative;
    display: block;
    height: 100%;
    overflow: hidden;
    border: 1px solid rgba(148, 163, 184, 0.25);
    border-radius: 1rem 3rem 1rem 3rem;
    background: radial-gradient(circle at var(--pointer-x) var(--pointer-y), var(--pointer-glow), transparent 44%);
    transition:
      transform 400ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 400ms ease,
      background-color 400ms ease,
      box-shadow 400ms ease;
  }

  .home-blog-card__content {
    position: relative;
    z-index: 1;
    padding: 1.35rem;
  }

  .home-blog-card:hover,
  .home-blog-card:focus-visible {
    transform: translateY(-5px);
    border-color: color-mix(in srgb, var(--color-primary) 76%, transparent);
    background-color: color-mix(in srgb, var(--color-primary) 10%, var(--color-card));
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--color-primary) 24%, transparent),
      0 20px 46px rgba(0, 0, 0, 0.42),
      0 0 34px color-mix(in srgb, var(--color-primary) 30%, transparent);
  }

  .home-blog-card:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .home-blog-card {
      transition: none;
    }

    .home-blog-card:hover,
    .home-blog-card:focus-visible {
      transform: none;
    }
  }
</style>
