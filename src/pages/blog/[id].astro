---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import { ArrowLeft, CalendarDays, Clock3, Bookmark } from 'lucide-react';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header';
import Footer from '../../components/Footer';
import { SITE_TITLE } from '../../config/site';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  return posts.map((post) => ({
    params: { id: post.id },
    props: post,
  }));
}

type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await render(post);
const relatedPosts = (await getCollection('blog'))
  .filter((entry) => entry.id !== post.id)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const publishedDate = post.data.pubDate.toLocaleDateString('en-us', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

const updatedDate = post.data.updatedDate?.toLocaleDateString('en-us', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<Layout
  title={`${post.data.title} | ${SITE_TITLE}`}
  description={post.data.description}
  ogType='article'
  article={{ publishedTime: post.data.pubDate.toISOString(), modifiedTime: post.data.updatedDate?.toISOString() }}
>
  <Header client:load />

  <main class='grow py-6 sm:py-10 relative overflow-hidden'>
    <!-- Back to Articles Button -->
    <div class='w-full max-w-267 mx-auto mb-6 sm:mb-8 relative z-10 pl-5'>
      <a href='/blog/' class='notebook-back-btn group inline-flex items-center gap-2 font-handwriting text-lg sm:text-xl text-muted hover:text-accent transition-colors duration-200'>
        <ArrowLeft className='h-4 w-4 transition-transform group-hover:-translate-x-1.5 text-accent' aria-hidden='true' />
        <span>Back to all articles</span>
      </a>
    </div>

    <!-- Main Blog Container matching Nav Width -->
    <article class='w-full max-w-267 mx-auto relative z-10'>
      <div class='notebook-paper relative w-full'>
        <!-- Article Header -->
        <header class='notebook-header mb-8 pb-8 border-b border-white/10 relative z-10'>
      
          <div class='relative inline-block w-full my-2'>
            <h1 class='font-handwriting text-4xl sm:text-6xl lg:text-7xl font-bold text-foreground leading-[1.08] tracking-wide'>
              {post.data.title}
            </h1>
            <!-- Sketchy Hand-drawn Underline SVG -->
            <svg class='handwritten-underline-svg w-full h-4 sm:h-6 text-accent opacity-85 my-2' viewBox='0 0 600 24' preserveAspectRatio='none' fill='none' xmlns='http://www.w3.org/2000/svg' aria-hidden='true'>
              <path d='M 6 14 Q 150 4, 300 16 T 594 10' stroke='currentColor' stroke-width='4' stroke-linecap='round' fill='none'/>
            </svg>
          </div>

          <!-- Handwritten Executive Summary Box -->
          <div class='notebook-summary-box mt-6 p-5 rounded-lg border border-accent/25 bg-accent/5 relative overflow-hidden'>
            <div class='font-handwriting text-accent font-bold text-base tracking-wider uppercase mb-1 flex items-center gap-2'>
              <Bookmark className='w-4 h-4' />
              <span>EXECUTIVE SUMMARY</span>
            </div>
            <p class='text-base sm:text-lg text-slate-200 leading-relaxed font-sans'>
              {post.data.description}
            </p>
          </div>

          <!-- Stamped Metadata Bar -->
          <div class='notebook-meta-stamp font-handwriting text-base sm:text-lg text-muted flex flex-wrap items-center gap-4 sm:gap-7 mt-6 pt-2'>
            <span class='inline-flex items-center gap-1.5 text-slate-300'>
              <CalendarDays className='h-4 w-4 text-accent' />
              <span>DATE: {publishedDate}</span>
            </span>
            <span class='inline-flex items-center gap-1.5 text-slate-300'>
              <Clock3 className='h-4 w-4 text-accent' />
              <span>EST. READ: 5 MIN</span>
            </span>
            <span class='text-accent font-semibold'>
              ★ AUTHOR: MANOJ CHAUDHARY
            </span>
            {updatedDate && <span class='text-xs text-muted font-sans ml-auto'>Updated: {updatedDate}</span>}
          </div>
        </header>

        <!-- Article Content -->
        <div class='notebook-prose prose prose-invert max-w-none relative z-10'>
          <Content />
        </div>
      </div>
    </article>

    <!-- Related Articles Index Cards -->
    {relatedPosts.length > 0 && (
      <section class='w-full max-w-267 mx-auto mt-20 relative z-10 pt-8 border-t border-white/10' aria-labelledby='related-heading'>
        <div class='mb-6'>
          <p class='text-xs font-bold tracking-widest text-primary uppercase mb-1'>Keep reading</p>
          <h2 id='related-heading' class='text-xl font-bold text-foreground sm:text-2xl'>More from the article</h2>
        </div>
        <ul class='grid gap-5 sm:grid-cols-2'>
          {relatedPosts.map((relatedPost) => (
            <li class='h-full'>
              <a href={`/blog/${relatedPost.id}/`} class='blog-card group'>
                <div class='blog-card__content'>
                  <h3 class='mb-3 text-xl font-medium text-foreground transition-colors duration-300 group-hover:text-primary'>
                    {relatedPost.data.title}
                  </h3>
                  <p class='text-sm leading-relaxed text-muted'>{relatedPost.data.description}</p>
                  <p class='mt-8 text-sm text-muted'>
                    <time datetime={relatedPost.data.pubDate.toISOString()}>
                      {relatedPost.data.pubDate.toLocaleDateString('en-us', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric',
                      })}
                    </time>
                  </p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>

  <Footer />
</Layout>

<script>
  const cards = document.querySelectorAll<HTMLElement>('.blog-card');

  cards.forEach((card) => {
    card.addEventListener('pointermove', (event) => {
      const bounds = card.getBoundingClientRect();
      const x = ((event.clientX - bounds.left) / bounds.width) * 100;
      const y = ((event.clientY - bounds.top) / bounds.height) * 100;

      card.style.setProperty('--pointer-x', `${x}%`);
      card.style.setProperty('--pointer-y', `${y}%`);
      card.style.setProperty('--pointer-glow', 'color-mix(in srgb, var(--color-primary) 20%, transparent)');
    });

    card.addEventListener('pointerleave', () => {
      card.style.setProperty('--pointer-glow', 'transparent');
    });
  });
</script>

<style>
  /* Standard Blog Card Styling (matching blog index page) */
  .blog-card {
    --pointer-x: 50%;
    --pointer-y: 50%;
    --pointer-glow: transparent;
    position: relative;
    display: block;
    height: 100%;
    overflow: hidden;
    border: 1px solid rgba(148, 163, 184, 0.25);
    border-radius: 1rem 3rem 1rem 3rem;
    background:
      radial-gradient(circle at var(--pointer-x) var(--pointer-y), var(--pointer-glow), transparent 36%), transparent;
    transition:
      transform 400ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 400ms ease,
      background-color 400ms ease,
      box-shadow 400ms ease;
  }

  .blog-card::after {
    position: absolute;
    inset: 0;
    border: 1px solid color-mix(in srgb, var(--color-primary) 34%, transparent);
    border-radius: inherit;
    content: '';
    opacity: 0;
    transition: opacity 400ms ease;
    pointer-events: none;
  }

  .blog-card__content {
    position: relative;
    z-index: 1;
    padding: 1.35rem;
  }

  .blog-card:hover,
  .blog-card:focus-visible {
    transform: translateY(-5px);
    border-color: color-mix(in srgb, var(--color-primary) 76%, transparent);
    background-color: color-mix(in srgb, var(--color-primary) 10%, var(--color-card));
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--color-primary) 24%, transparent),
      0 18px 42px rgba(0, 0, 0, 0.28),
      0 0 28px color-mix(in srgb, var(--color-primary) 18%, transparent);
  }

  .blog-card:hover::after,
  .blog-card:focus-visible::after {
    opacity: 1;
  }

  .blog-card:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 4px;
  }

  /* Animated Hand-drawn Underline */
  .handwritten-underline-svg path {
    stroke-dasharray: 600;
    stroke-dashoffset: 0;
    animation: drawLine 1.2s cubic-bezier(0.25, 1, 0.5, 1) forwards;
  }

  @keyframes drawLine {
    from {
      stroke-dashoffset: 600;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  /* Notebook Content / MDX Styling */
  .notebook-prose :global(h1:first-child) {
    display: none;
  }

  .notebook-prose :global(h2) {
    font-family: 'Caveat', 'Patrick Hand', cursive, sans-serif;
    font-size: 2.25rem;
    font-weight: 700;
    color: #ffffff;
    margin-top: 3.25rem;
    margin-bottom: 1.25rem;
    letter-spacing: 0.01em;
    border-bottom: 1px dashed rgba(126, 231, 198, 0.3);
    padding-bottom: 0.4rem;
    position: relative;
  }

  .notebook-prose :global(h3) {
    font-family: 'Caveat', 'Patrick Hand', cursive, sans-serif;
    font-size: 1.8rem;
    font-weight: 700;
    color: #7ee7c6;
    margin-top: 2.25rem;
    margin-bottom: 0.85rem;
  }

  .notebook-prose :global(h4),
  .notebook-prose :global(h5) {
    font-family: 'Caveat', 'Patrick Hand', cursive, sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: #e2e8f0;
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
  }

  .notebook-prose :global(p),
  .notebook-prose :global(li) {
    color: #cbd5e1;
    font-size: 1.05rem;
    line-height: 1.85;
    margin-bottom: 1.25rem;
  }

  .notebook-prose :global(ul) {
    list-style-type: none;
    padding-left: 1.25rem;
  }

  .notebook-prose :global(ul > li) {
    position: relative;
    padding-left: 1.5rem;
  }

  .notebook-prose :global(ul > li::before) {
    content: '➺';
    position: absolute;
    left: 0;
    top: 0;
    color: #7ee7c6;
    font-family: 'Caveat', cursive;
    font-size: 1.3rem;
  }

  /* Code Block styling as dark ink snippet */
  .notebook-prose :global(pre) {
    position: relative;
    background-color: #0c100e !important;
    border: 1px solid rgba(126, 231, 198, 0.22);
    border-radius: 0.6rem;
    padding: 1.25rem 1.5rem;
    margin: 2rem 0;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
    font-family: 'Fira Code', monospace;
    font-size: 0.95rem;
    line-height: 1.65;
    overflow-x: auto;
  }

  .notebook-prose :global(code) {
    font-family: 'Fira Code', monospace;
    background-color: rgba(126, 231, 198, 0.12);
    border: 1px dashed rgba(126, 231, 198, 0.35);
    border-radius: 4px;
    padding: 0.15rem 0.45rem;
    color: #7ee7c6;
    font-size: 0.9em;
    font-weight: 500;
  }

  .notebook-prose :global(pre code) {
    background-color: transparent;
    border: none;
    padding: 0;
    color: inherit;
    font-size: inherit;
  }

  /* Sticky Note Blockquote */
  .notebook-prose :global(blockquote) {
    position: relative;
    background-color: #151d18;
    border-left: 4px solid #7ee7c6;
    border-radius: 0 8px 8px 0;
    padding: 1.25rem 1.5rem;
    margin: 2rem 0;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
  }

  .notebook-prose :global(blockquote::before) {
    content: '📌 NOTEBOOK ANNOTATION';
    display: block;
    font-family: 'Caveat', cursive;
    font-size: 1.1rem;
    font-weight: 700;
    color: #7ee7c6;
    margin-bottom: 0.5rem;
    letter-spacing: 0.05em;
  }

  .notebook-prose :global(blockquote p) {
    margin-bottom: 0;
    font-style: italic;
    color: #e2e8f0;
  }

  /* Table styling */
  .notebook-prose :global(table) {
    width: 100%;
    margin: 2rem 0;
    border-collapse: collapse;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background-color: rgba(0, 0, 0, 0.2);
  }

  .notebook-prose :global(th) {
    font-family: 'Caveat', cursive;
    font-size: 1.3rem;
    color: #7ee7c6;
    background-color: rgba(126, 231, 198, 0.08);
    padding: 0.75rem 1rem;
    text-align: left;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  }

  .notebook-prose :global(td) {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    color: #cbd5e1;
  }

  .notebook-prose :global(tr:nth-child(even)) {
    background-color: rgba(255, 255, 255, 0.02);
  }

  .notebook-prose :global(a) {
    color: #7ee7c6;
    text-decoration: none;
    border-bottom: 1px dashed #7ee7c6;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .notebook-prose :global(a:hover) {
    color: #ffffff;
    border-bottom-style: solid;
  }

  @media (prefers-reduced-motion: reduce) {
    .handwritten-underline-svg path {
      animation: none;
    }
  }
</style>
